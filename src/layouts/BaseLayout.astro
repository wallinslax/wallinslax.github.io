---
import Header from '../components/Header.astro';
import { getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import avatar from '../assets/avatar.jpg';
import Analytics from '../components/Analytics.astro';
import ConsentBar from '../components/ConsentBar.astro';
import { SITE_TITLE } from '../consts';
import { LANG_META, availableLangs, localizePath, splitLangPath, useStrings, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Show the "Machine-translated from English" note. Defaults to true on non-English pages. */
  machineTranslated?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
}

const { lang = 'en', title, ogType = 'website', publishedTime } = Astro.props;
const t = useStrings(lang);
const description = Astro.props.description ?? `${t('home.tagline')}`;
const machineTranslated = Astro.props.machineTranslated ?? lang !== 'en';
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const { path } = splitLangPath(Astro.url.pathname);
const ogImage = new URL((await getImage({ src: avatar, width: 400, height: 400, format: 'jpg' })).src, Astro.site);
const alternates = availableLangs().map((l) => ({ hreflang: LANG_META[l].htmlLang, href: new URL(localizePath(path, l), Astro.site) }));
---

<!doctype html>
<html lang={LANG_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternates.length > 1 && alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <Analytics />
    <script is:inline>
      // Apply a saved light/dark choice before first paint to avoid a flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      {machineTranslated && (
        <p class="translation-note">
          {t('translation.note')} · <a href={path} hreflang="en" lang="en">{t('translation.readOriginal')}</a>
        </p>
      )}
      <slot />
    </main>
    <Footer lang={lang} />
    <ConsentBar lang={lang} />
  </body>
</html>

<style>
  .translation-note {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
