---
import Header from '../components/Header.astro';
import { getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import avatar from '../assets/avatar.jpg';
import Analytics from '../components/Analytics.astro';
import ConsentBar from '../components/ConsentBar.astro';
import { GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../consts';
import { LANG_META, availableLangs, localizePath, splitLangPath, useStrings, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Show the "Machine-translated from English" note. Defaults to true on non-English pages. */
  machineTranslated?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  /** Article pages only: feed the BlogPosting structured data. */
  modifiedTime?: Date;
  keywords?: string[];
  /** Language the article text is actually in (English when a translation falls back). */
  contentLang?: Lang;
}

const { lang = 'en', title, ogType = 'website', publishedTime, modifiedTime, keywords, contentLang = lang } = Astro.props;
const t = useStrings(lang);
const description = Astro.props.description ?? `${t('home.tagline')}`;
const machineTranslated = Astro.props.machineTranslated ?? lang !== 'en';
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const { path } = splitLangPath(Astro.url.pathname);
const ogImage = new URL((await getImage({ src: avatar, width: 400, height: 400, format: 'jpg' })).src, Astro.site);
// On the home page, tell search engines who the site is about.
const personId = new URL('/#person', Astro.site).href;
const person = path === '/' && {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId,
  name: SITE_TITLE,
  url: new URL('/', Astro.site).href,
  image: ogImage.href,
  sameAs: [GITHUB_URL, LINKEDIN_URL],
};
// On article pages, describe the post and credit it to the same person.
const posting = ogType === 'article' && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  inLanguage: LANG_META[contentLang].htmlLang,
  datePublished: publishedTime?.toISOString(),
  dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
  keywords,
  image: ogImage.href,
  author: { '@type': 'Person', '@id': personId, name: SITE_TITLE, url: new URL('/', Astro.site).href },
};
const alternates = availableLangs().map((l) => ({ hreflang: LANG_META[l].htmlLang, href: new URL(localizePath(path, l), Astro.site) }));
---

<!doctype html>
<html lang={LANG_META[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {alternates.length > 1 && alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{pageTitle}</title>
    <Analytics />
    <script is:inline>
      // Apply a saved light/dark choice before first paint to avoid a flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content={LANG_META[lang].ogLocale} />
    <meta property="og:image" content={ogImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    {person && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    {posting && <script type="application/ld+json" set:html={JSON.stringify(posting)} />}
  </head>
  <body>
    <Header lang={lang} />
    <main>
      {machineTranslated && (
        <p class="translation-note">
          {t('translation.note')} · <a href={path} hreflang="en" lang="en">{t('translation.readOriginal')}</a>
        </p>
      )}
      <slot />
    </main>
    <Footer lang={lang} />
    <ConsentBar lang={lang} />
  </body>
</html>

<style>
  .translation-note {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
