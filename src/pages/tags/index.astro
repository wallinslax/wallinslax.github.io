---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticles, tagSlug, tagUrl } from '../../utils';

const counts = new Map<string, { name: string; count: number }>();
for (const article of await getArticles()) {
  for (const name of article.data.tags) {
    const slug = tagSlug(name);
    const entry = counts.get(slug) ?? { name, count: 0 };
    entry.count += 1;
    counts.set(slug, entry);
  }
}
const tags = [...counts.values()].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));
---

<BaseLayout title="Tags" description="Browse articles by tag.">
  <h1>Tags</h1>
  <ul>
    {tags.map(({ name, count }) => (
      <li><a class="tag" href={tagUrl(name)}>{name} <span>{count}</span></a></li>
    ))}
  </ul>
</BaseLayout>

<style>
  ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .tag { font-size: 0.95rem; padding: 0.25rem 0.75rem; }
  span { opacity: 0.65; margin-left: 0.2rem; }
</style>
