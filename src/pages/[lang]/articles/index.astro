---
import ArticlesPage from '../../../components/pages/ArticlesPage.astro';
import { URL_SEGMENT, langFromSegment, translatedLangs } from '../../../i18n';

export function getStaticPaths() {
  return translatedLangs().map((lang) => ({ params: { lang: URL_SEGMENT[lang] } }));
}

const lang = langFromSegment(Astro.params.lang);
---

<ArticlesPage lang={lang} />
