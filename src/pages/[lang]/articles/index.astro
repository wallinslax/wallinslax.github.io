---
import ArticlesPage from '../../../components/pages/ArticlesPage.astro';
import { translatedLangs, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return translatedLangs().map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<ArticlesPage lang={lang} />
