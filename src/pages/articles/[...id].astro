---
import ArticlePage from '../../components/pages/ArticlePage.astro';
import { getLocalArticles, type LocalArticle } from '../../utils';

export async function getStaticPaths() {
  const articles = await getLocalArticles('en');
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: LocalArticle };
---

<ArticlePage article={article} lang="en" />
