---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/articles/', label: 'Articles' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header>
  <nav>
    <a class="brand" href="/">{SITE_TITLE}</a>
    <ul>
      {links.map(({ href, label }) => (
        <li><a href={href} class:list={{ active: isActive(href) }}>{label}</a></li>
      ))}
    </ul>
    <button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" fill="currentColor" />
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" />
        </g>
      </svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M21 14.5A9 9 0 0 1 9.5 3a9 9 0 1 0 11.5 11.5Z" fill="currentColor" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    // Keep the giscus comment box in sync.
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: next } } }, 'https://giscus.app');
  });
</script>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  nav {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.9rem 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand { font-weight: 700; color: var(--text); }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0 0 0 auto; padding: 0; }
  button {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  button:hover { color: var(--text); background: var(--surface); }
  .moon { display: none; }
  :global(:root[data-theme='dark']) .sun { display: none; }
  :global(:root[data-theme='dark']) .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun { display: none; }
    :global(:root:not([data-theme='light'])) .moon { display: block; }
  }
  ul a { color: var(--muted); }
  ul a.active, ul a:hover { color: var(--text); text-decoration: none; }
  ul a.active { font-weight: 600; }
</style>
