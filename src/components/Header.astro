---
import { SITE_TITLE } from '../consts';
import { LANG_META, availableLangs, localizePath, splitLangPath, useStrings, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useStrings(lang);
const { path } = splitLangPath(Astro.url.pathname);
const links = [
  { base: '/', label: t('nav.home') },
  { base: '/articles/', label: t('nav.articles') },
];
const isActive = (base: string) => (base === '/' ? path === '/' : path.startsWith(base));
const langs = availableLangs();
---

<header>
  <nav>
    <a class="brand" href={localizePath('/', lang)}>{SITE_TITLE}</a>
    <ul>
      {links.map(({ base, label }) => (
        <li><a href={localizePath(base, lang)} class:list={{ active: isActive(base) }}>{label}</a></li>
      ))}
    </ul>
    {langs.length > 1 && (
      <details class="lang">
        <summary aria-label={t('nav.language')} title={t('nav.language')}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-2.95a15.7 15.7 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.9 8ZM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96ZM4.26 14a8.2 8.2 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26Zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56A7.99 7.99 0 0 1 5.08 16Zm2.95-8H5.08a7.99 7.99 0 0 1 4.33-3.56A15.7 15.7 0 0 0 8.03 8ZM12 19.96A14.1 14.1 0 0 1 10.09 16h3.82A14.1 14.1 0 0 1 12 19.96ZM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4Zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56ZM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.2 8.2 0 0 1 0 4h-3.38Z" fill="currentColor" />
          </svg>
          <span>{LANG_META[lang].label}</span>
        </summary>
        <ul>
          {langs.map((l) => (
            <li>
              <a href={localizePath(path, l)} hreflang={LANG_META[l].htmlLang} lang={LANG_META[l].htmlLang} aria-current={l === lang ? 'true' : undefined}>
                {LANG_META[l].label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    )}
    <button id="theme-toggle" type="button" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <circle cx="12" cy="12" r="4.5" fill="currentColor" />
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" />
        </g>
      </svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M21 14.5A9 9 0 0 1 9.5 3a9 9 0 1 0 11.5 11.5Z" fill="currentColor" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () => root.dataset.theme ?? (media.matches ? 'dark' : 'light');

  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    // Keep the giscus comment box in sync.
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: next } } }, 'https://giscus.app');
  });
</script>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  nav {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.9rem 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand { font-weight: 700; color: var(--text); white-space: nowrap; margin-right: auto; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  @media (max-width: 480px) {
    nav { gap: 0.6rem; }
    ul { gap: 0.8rem; }
    .lang summary { padding: 0 0.35rem; }
  }
  .lang { position: relative; }
  .lang summary {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    height: 34px;
    padding: 0 0.5rem;
    border-radius: 8px;
    color: var(--muted);
    font-size: 0.85rem;
    cursor: pointer;
    list-style: none;
  }
  .lang summary::-webkit-details-marker { display: none; }
  .lang summary:hover,
  .lang[open] summary { color: var(--text); background: var(--surface); }
  .lang summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .lang ul {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    display: grid;
    gap: 0;
    min-width: 7rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.12);
    z-index: 20;
  }
  .lang ul a {
    display: block;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    color: var(--text);
    font-size: 0.9rem;
  }
  .lang ul a:hover { background: var(--surface); text-decoration: none; }
  .lang ul a[aria-current] { color: var(--accent); font-weight: 600; }
  button {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  button:hover { color: var(--text); background: var(--surface); }
  .moon { display: none; }
  :global(:root[data-theme='dark']) .sun { display: none; }
  :global(:root[data-theme='dark']) .moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun { display: none; }
    :global(:root:not([data-theme='light'])) .moon { display: block; }
  }
  ul a { color: var(--muted); }
  ul a.active, ul a:hover { color: var(--text); text-decoration: none; }
  ul a.active { font-weight: 600; }
</style>
