---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../Comments.astro';
import ListenButton from '../ListenButton.astro';
import PodcastButton from '../PodcastButton.astro';
import ShareButton from '../ShareButton.astro';
import { formatDateFor, localizePath, useStrings, type Lang } from '../../i18n';
import { readingTime, tagUrl, type LocalArticle } from '../../utils';

interface Props {
  article: LocalArticle;
  lang: Lang;
}

const { article, lang } = Astro.props;
const t = useStrings(lang);
const { pubDate, updatedDate, tags } = article.en.data;
// Render the translation when it is current; otherwise fall back to the English article.
const { Content } = await render(article.translation ?? article.en);
const contentLang = article.translation ? lang : 'en';
// Same content in every language, so every language shows the English reading time.
const minutes = readingTime(article.en.body);
const englishPath = `/articles/${article.id}/`;
const shareUrl = new URL(localizePath(englishPath, lang), Astro.site).href;
---

<BaseLayout lang={lang} title={article.title} description={article.description} machineTranslated={!!article.translation} ogType="article" publishedTime={pubDate} modifiedTime={updatedDate} keywords={tags} contentLang={contentLang}>
  <a class="back" href={localizePath('/articles/', lang)}>{t('article.back')}</a>
  <article lang={contentLang === lang ? undefined : 'en'}>
    <header>
      <h1>{article.title}</h1>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{formatDateFor(lang, pubDate)}</time>
        {updatedDate && <span>· {t('article.updated', { date: formatDateFor(lang, updatedDate) })}</span>}
        <span>· {t('article.minRead', { n: minutes })}</span>
        {tags.map((tag) => <a class="tag" href={tagUrl(tag, lang)}>{tag}</a>)}
      </div>
      <div class="actions">
        <PodcastButton lang={lang} articleFile={article.en.filePath} />
        <ListenButton lang={lang} />
        <ShareButton lang={lang} title={article.title} url={shareUrl} />
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <Comments lang={lang} path={englishPath} />
</BaseLayout>

<style>
  .back { font-size: 0.9rem; }
  header { margin: 1rem 0 2rem; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.4rem); margin: 0 0 0.6rem; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-top: 1rem; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; color: var(--muted); font-size: 0.9rem; }
  .prose :global(h2) { margin-top: 2.2rem; }
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 1.25rem 0;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.5rem 0.75rem 0.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .prose :global(th) { color: var(--muted); font-weight: 600; }
  /* IEEE-style references: list items that start with an anchor like <span id="ref-1"> */
  .prose :global(ul:has(> li > span[id^='ref-'])) {
    list-style: none;
    padding-left: 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .prose :global(li:has(> span[id^='ref-'])) { margin: 0 0 0.6rem; overflow-wrap: anywhere; }
  .prose :global(li:has(> span:target)) { color: var(--text); background: var(--accent-soft); border-radius: 4px; box-shadow: 0 0 0 4px var(--accent-soft); }
  .prose :global(span[id^='ref-']) { scroll-margin-top: 5rem; }
  .prose :global(a[href^='#ref-']) { text-decoration: none; font-size: 0.85em; }
  .prose :global(blockquote) { margin: 1.5rem 0; padding: 0.2rem 1rem; border-left: 3px solid var(--accent); color: var(--muted); }
</style>
