---
// Reads the article aloud with the browser's built-in speech synthesis.
// Hidden when the browser doesn't support it.
import { useStrings, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = useStrings(Astro.props.lang);
const labels = {
  listen: t('listen.listen'),
  pause: t('listen.pause'),
  resume: t('listen.resume'),
  listenLabel: t('listen.listenLabel'),
  pauseLabel: t('listen.pauseLabel'),
};
---

<div class="listen" id="listen" data-labels={JSON.stringify(labels)} hidden>
  <button type="button" id="listen-play" aria-label={labels.listenLabel}>
    <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
    <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg>
    <span id="listen-label">{labels.listen}</span>
  </button>
  <button type="button" id="listen-stop" class="stop" aria-label={t('listen.stopLabel')} hidden>
    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 6h12v12H6z" fill="currentColor" /></svg>
  </button>
</div>

<script>
  import { pickVoice } from '../voices';

  const synth = window.speechSynthesis;
  const box = document.getElementById('listen') as HTMLElement;
  const play = document.getElementById('listen-play') as HTMLButtonElement;
  const stop = document.getElementById('listen-stop') as HTMLButtonElement;
  const label = document.getElementById('listen-label') as HTMLElement;

  if (synth && box) {
    box.hidden = false;
    const labels = JSON.parse(box.dataset.labels ?? '{}');
    type State = 'idle' | 'playing' | 'paused';
    let state: State = 'idle';
    let blocks: HTMLElement[] = [];
    let index = 0;
    let run = 0; // bumps on every jump so a cancelled utterance's onend is ignored

    // One opinionated voice per language (see src/voices.ts); no picker, by design.
    const lang = document.querySelector('article')?.closest('[lang]')?.getAttribute('lang') || 'en';
    let voice: SpeechSynthesisVoice | undefined;
    const loadVoice = () => {
      voice = pickVoice(synth.getVoices(), lang);
    };
    loadVoice();
    synth.addEventListener?.('voiceschanged', loadVoice);

    const setState = (next: State) => {
      state = next;
      box.dataset.state = next;
      document.documentElement.classList.toggle('listening', next !== 'idle');
      label.textContent = next === 'playing' ? labels.pause : next === 'paused' ? labels.resume : labels.listen;
      play.setAttribute('aria-label', next === 'playing' ? labels.pauseLabel : labels.listenLabel);
      stop.hidden = next === 'idle';
    };

    const clearHighlight = () => blocks.forEach((el) => el.classList.remove('speaking'));

    // Read paragraph by paragraph: long single utterances get cut off in some browsers,
    // and it lets us highlight where we are. Code blocks are skipped.
    // Skip the References list (and its heading): URLs read aloud are noise.
    const REF_LIST = 'ul:has(> li > span[id^="ref-"])';
    const isReference = (el: HTMLElement) =>
      !!el.closest(REF_LIST) || (el.tagName === 'H2' && !!el.nextElementSibling?.matches(REF_LIST));

    const collect = () => {
      const title = document.querySelector<HTMLElement>('article header h1');
      const body = [...document.querySelectorAll<HTMLElement>('.prose :is(p, h2, h3, h4, li, blockquote)')].filter(
        (el) =>
          !el.closest('pre') &&
          !el.parentElement?.closest('li, blockquote') &&
          !isReference(el) &&
          el.innerText.trim(),
      );
      return title ? [title, ...body] : body;
    };

    // Speak in sentence-sized pieces. Chrome's online (Google) voices stop after about
    // 15 seconds of one utterance, and short pieces also make pause/resume and jumps snappy.
    const MAX = 160;
    const split = (text: string) => {
      const sentences = text.match(/(?:[^。！？!?；;.]|\.(?!\s|$))+(?:[。！？!?；;.]+[”」』）)"']*)?\s*/g) ?? [text];
      const parts: string[] = [];
      for (const sentence of sentences) {
        const pieces = sentence.length > MAX ? (sentence.match(/[^，、,：:]+[，、,：:]?\s*/g) ?? [sentence]) : [sentence];
        // Last resort for a clause with no punctuation: break at spaces, or every MAX characters.
        const fits = pieces.flatMap((t) => (t.length > MAX ? (t.match(/[\s\S]{1,160}(?:\s+|$)|[\s\S]{1,160}/g) ?? [t]) : [t]));
        for (const piece of fits) {
          const last = parts.length - 1;
          if (last >= 0 && parts[last].length + piece.length <= MAX) parts[last] += piece;
          else parts.push(piece);
        }
      }
      return parts.map((t) => t.trim()).filter(Boolean);
    };

    let part = 0;
    let parts: string[] = [];
    // Keep a reference: Chrome can garbage-collect a pending utterance and never fire onend.
    let utterance: SpeechSynthesisUtterance | undefined;

    const speakPart = () => {
      utterance = new SpeechSynthesisUtterance(parts[part]);
      if (voice) utterance.voice = voice;
      utterance.lang = voice?.lang ?? lang;
      utterance.rate = 1;
      const current = ++run;
      utterance.onend = () => {
        if (current !== run || state !== 'playing') return;
        if (++part < parts.length) speakPart();
        else speakFrom(index + 1);
      };
      synth.speak(utterance);
    };

    const speakFrom = (i: number, fromPart = 0) => {
      clearHighlight();
      if (i >= blocks.length) {
        setState('idle');
        return;
      }
      index = i;
      const el = blocks[i];
      el.classList.add('speaking');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      el.scrollIntoView({ block: 'nearest', behavior: reduceMotion ? 'auto' : 'smooth' });
      parts = split(el.innerText.replace(/\s*\[\d+\]/g, ''));
      part = Math.min(fromPart, parts.length - 1);
      speakPart();
    };

    // Start over at a block, also from a paused state (Chrome keeps the paused flag after cancel).
    const restart = (i: number, fromPart = 0) => {
      run++;
      synth.cancel();
      synth.resume();
      setState('playing');
      speakFrom(i, fromPart);
    };

    // Online voices (Chrome's Google voices) don't pause reliably, so for those, pause means
    // stop and resume means repeat the current sentence. Local voices use the native pause.
    const online = () => !!voice && !voice.localService;

    play.addEventListener('click', () => {
      if (state === 'idle') {
        blocks = collect();
        synth.cancel();
        setState('playing');
        speakFrom(0);
      } else if (state === 'playing') {
        if (online()) {
          run++;
          synth.cancel();
        } else synth.pause();
        setState('paused');
      } else {
        setState('playing');
        if (online()) speakFrom(index, part);
        else synth.resume();
      }
    });

    // While listening, click a paragraph to jump there.
    document.querySelector('article')?.addEventListener('click', (event) => {
      if (state === 'idle') return;
      const target = event.target as HTMLElement;
      if (target.closest('a, button') || window.getSelection()?.toString()) return;
      const i = blocks.findIndex((el) => el.contains(target));
      if (i === -1) return;
      restart(i);
    });

    stop.addEventListener('click', () => {
      setState('idle');
      run++;
      synth.cancel();
      clearHighlight();
    });

    window.addEventListener('pagehide', () => synth.cancel());
  }
</script>

<style>
  .listen { display: inline-flex; gap: 0.35rem; }
  button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
  }
  button:hover { border-color: var(--muted); }
  button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .stop { align-self: stretch; padding: 0.3rem 0.65rem; color: var(--muted); }
  .listen { flex-wrap: wrap; align-items: center; }
  .icon-pause { display: none; }
  .listen[data-state='playing'] .icon-play { display: none; }
  .listen[data-state='playing'] .icon-pause { display: block; }
  :global(.listening .prose :is(p, h2, h3, h4, li, blockquote)),
  :global(.listening article header h1) { cursor: pointer; }
  :global(.listening .prose :is(p, h2, h3, h4, li, blockquote):not(.speaking):hover) {
    background: var(--surface);
    border-radius: 4px;
    box-shadow: 0 0 0 4px var(--surface);
  }
  :global(.speaking) {
    background: var(--accent-soft);
    border-radius: 4px;
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
</style>
